{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capabilities of the TruongPhoto main desktop window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/**",
      "http://localhost:1420/**"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "autostart:default",
    "updater:default",
    "process:allow-restart",
    "shell:allow-open",
    "allow-get-desktop-bootstrap",
    "allow-get-power-state",
    "allow-show-main-window",
    "allow-quit-app",
    "allow-check-update-feed"
  ]
}
